---
import WorkLogo from '../components/WorkLogo.astro';
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.png';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import NewsList from '../components/NewsList.astro';
import { getNews } from '../lib/content';
import { works } from '../data/works';

const featured = works[0];
const latestNews = (await getNews()).slice(0, 3);
---

<Base overHero="light">
  <section class="hero">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={82}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt="麦わら帽子の少女が、防波堤に腰掛けて海を眺めているイラスト"
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="hero-center">
      <h1 class="hero-badge"><Logo kind="badge-line" tone="black" loading="eager" /></h1>
    </div>
    <p class="hero-catch">ことばとしあわせのおはなし</p>
  </section>

  <section id="intro" class="container intro reveal">
    <p class="intro-text">ぽんこつソフトは、少しダークで切ないノベルゲームをつくる同人サークルです。</p>
    <p class="intro-meta en">Since {site.founded}</p>
  </section>

  <section class="night featured">
    <a href={u(`/works/${featured.slug}`)} class="container featured-inner reveal">
      <p class="status"><span>{featured.status}</span>{featured.genre}</p>
      <h2 class="work-title"><WorkLogo slug={featured.slug} title={featured.title} tone="white" /></h2>
      <p class="catch">{featured.catchcopy}</p>
      <span class="link-arrow">View the work</span>
    </a>
  </section>

  <section class="section container narrow about reveal">
    <h2>ぽんこつソフトについて</h2>
    <div class="prose">
      <p>シナリオは、2000年前後のノベルゲームに強く影響を受けています。</p>
      <p>立ち絵は大事な場面だけに使い、風景と文章で読ませる作品を目指しています。いま制作しているのは、鈍行列車で西へ向かう二人の十四日間を描くキネティックノベル『{featured.title}』です。</p>
    </div>
    <dl class="facts">
      <div><dt>設立</dt><dd>{site.founded}年</dd></div>
      <div><dt>活動</dt><dd>ビジュアルノベル（キネティックノベル）の企画・制作</dd></div>
    </dl>
    <p class="about-links">
      <a href={u('/about')} class="link-arrow">About us</a>
      <a href={u('/members')} class="link-arrow">Members</a>
    </p>
  </section>

  <section class="section container narrow news reveal">
    <h2>お知らせ</h2>
    <NewsList items={latestNews} />
    <a href={u('/news')} class="link-arrow more">All news</a>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: linear-gradient(#bdf0e6, #8fdcdc 60%, #2f4b4c);
    color: #fff;
  }
  .hero :global(.hero-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    animation: settle 6s var(--ease) both;
  }
  .hero :global(picture) { display: contents; }
  @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }

  /* 透明感：全体を少し白く霞ませ、下端はページ色に溶かす */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 46%, rgb(255 255 255 / 0.32), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.18), transparent 28%, transparent 68%, color-mix(in srgb, var(--paper) 70%, transparent) 92%, var(--paper));
    mix-blend-mode: normal;
  }
  /* ゆっくりと横切る光 */
  .hero-light {
    position: absolute;
    inset: -20% -40%;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.22) 46%, rgb(255 250 230 / 0.12) 52%, transparent 60%);
    animation: sheen 14s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes sheen {
    0% { transform: translateX(-40%); opacity: 0; }
    20% { opacity: 1; }
    60%, 100% { transform: translateX(40%); opacity: 0; }
  }

  /* ロゴは中央に。箱は塗らず枠線だけにして、内側はうっすら曇りガラス越しに空が透ける */
  .hero-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 22px;
    padding: 0 var(--gutter) 6vh;
    animation: rise 2s var(--ease) both 0.6s;
  }
  .hero-badge { position: relative; }
  .hero-badge::before {
    content: '';
    position: absolute;
    inset: 2px;
    background: rgb(255 255 255 / 0.16);
    backdrop-filter: blur(8px) saturate(1.1);
    -webkit-backdrop-filter: blur(8px) saturate(1.1);
  }
  .hero-badge :global(img) {
    position: relative;
    display: block;
    width: clamp(260px, 30vw, 440px);
    height: auto;
  }
  /* キャッチコピーは右下の隅に、小さく */
  .hero-catch {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(28px, 6vh, 56px);
    font-family: var(--font-ui);
    font-size: clamp(13px, 1.1vw, 15px);
    letter-spacing: 0.32em;
    color: var(--ink);
    animation: rise 2s var(--ease) both 1.4s;
  }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  /* Intro：ひと目でわかる紹介 */
  .intro { padding-block: clamp(72px, 10vw, 120px); text-align: center; }
  .intro-text { font-size: clamp(16px, 1.8vw, 20px); letter-spacing: 0.08em; line-height: 2; }
  .intro-meta { margin-top: 12px; font-size: 13px; color: var(--mute); letter-spacing: 0.16em; }

  /* 作品：ロゴを主役に中央へ。ブロック全体が作品ページへのリンク */
  .featured-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(96px, 13vw, 168px);
    color: inherit;
  }
  .status { display: flex; gap: 14px; align-items: center; font-size: 13px; color: var(--mute); letter-spacing: 0.14em; }
  .status span { font-size: 12px; color: var(--ink); border: 1px solid var(--line); padding: 1px 12px; letter-spacing: 0.2em; }
  .work-title { margin-top: 36px; }
  .work-title :global(img) { width: clamp(240px, 40vw, 520px); height: auto; }
  .catch { margin-top: 32px; font-size: clamp(15px, 1.5vw, 18px); letter-spacing: 0.12em; }
  .featured-inner .link-arrow { margin-top: 48px; }
  .featured-inner:hover .link-arrow { gap: 22px; }

  /* About・News：一段組み */
  .about h2, .news h2 { font-size: 22px; letter-spacing: 0.16em; margin-bottom: 32px; }
  .about .prose { max-width: 34em; }
  .about .prose p + p { margin-top: 1.2em; }
  .facts { margin-top: 40px; }
  .facts > div { display: grid; grid-template-columns: 100px 1fr; gap: 24px; padding-block: 16px; border-top: 1px solid var(--line); }
  .facts > div:last-child { border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 13px; color: var(--mute); letter-spacing: 0.14em; }
  .facts dd { margin: 0; }
  .about-links { display: flex; gap: 40px; margin-top: 36px; }
  .news { padding-top: 0; }
  .news .more { margin-top: 32px; }

  @media (max-width: 640px) {
    .hero :global(.hero-image) { object-position: 22% 50%; }
  }
  @media (max-width: 560px) {
    .facts > div { grid-template-columns: 1fr; gap: 2px; }
    .hero-badge :global(img) { width: 76vw; }
    /* スマホでは人物の顔にかからないよう、空の位置へ */
    .hero-center { justify-content: flex-start; padding-top: 14svh; }
    .hero-catch { font-size: 13px; letter-spacing: 0.26em; }
  }
</style>
