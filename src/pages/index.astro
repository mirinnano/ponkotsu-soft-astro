---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import { Picture } from 'astro:assets';
import heroImage from '../assets/hero.png';
import Progress from '../components/Progress.astro';
import Logo from '../components/Logo.astro';
import { site } from '../data/site';
import NewsList from '../components/NewsList.astro';
import { getNews } from '../lib/content';
import { works, totalProgress } from '../data/works';
import { members } from '../data/members';

const featured = works[0];
const latestNews = (await getNews()).slice(0, 3);
---

<Base overHero="light">
  <section class="hero">
    <Picture
      src={heroImage}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      quality={82}
      widths={[768, 1280, 1920]}
      sizes="100vw"
      alt="麦わら帽子の少女が、防波堤に腰掛けて海を眺めているイラスト"
      class="hero-image"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero-veil" aria-hidden="true"></div>
    <div class="hero-light" aria-hidden="true"></div>
    <div class="hero-sign container">
      <h1><Logo kind="wordmark" loading="eager" class="hero-name" /></h1>
    </div>
    <a href="#intro" class="scroll en" aria-label="下へスクロール">Scroll</a>
  </section>

  <section id="intro" class="container intro reveal">
    <p class="intro-text">
      ぽんこつソフトは、少しダークで切ないノベルゲームをつくる同人サークルです。
    </p>
    <p class="intro-meta en">Since {site.founded} <span aria-hidden="true">·</span> Now making <i>{featured.titleEn}</i></p>
  </section>

  <section class="night featured">
    <div class="container section featured-inner">
      <div class="featured-title reveal">
        <p class="label">Works</p>
        <h2 class="work-title">{featured.title}</h2>
        <p class="work-en en">{featured.titleEn}</p>
      </div>
      <div class="featured-body reveal">
        <p class="status"><span>{featured.status}</span>{featured.genre}</p>
        <p class="catch">{featured.catchcopy}</p>
        <p class="synopsis">
          {featured.synopsis[0]}
          {featured.synopsis[1]}
        </p>
        <Progress label="開発進捗" value={totalProgress(featured)} />
        <a href={u(`/works/${featured.slug}`)} class="link-arrow">View the work</a>
      </div>
    </div>
  </section>

  <section class="section container about">
    <div class="about-head reveal">
      <p class="label">About</p>
      <h2>ぽんこつソフトについて</h2>
    </div>
    <div class="about-body reveal">
      <div class="prose">
        <p>
          ぽんこつソフトは、息苦しい日常から逃げ出したいと願う人へ向けて、少しダークで切ない純文学風ビジュアルノベルを制作するサークルです。
        </p>
        <p>
          名作ノベルゲームの系譜を受け継ぎ、優しくて冷たい「もう一つの現実」をテキストで紡いでいます。
        </p>
      </div>
      <dl class="facts">
        <div><dt>設立</dt><dd>{site.founded}年</dd></div>
        <div><dt>活動</dt><dd>ビジュアルノベル（キネティックノベル）の企画・制作</dd></div>
        <div>
          <dt>メンバー</dt>
          <dd>
            {members.map((m) => (
              <span class="member">{m.name}<small class="en">{m.roles.join(' / ')}</small></span>
            ))}
          </dd>
        </div>
      </dl>
      <p class="about-links">
        <a href={u('/about')} class="link-arrow">About us</a>
        <a href={u('/members')} class="link-arrow">Members</a>
      </p>
    </div>
  </section>

  <section class="section container news">
    <div class="news-head reveal">
      <p class="label">News</p>
      <h2>お知らせ</h2>
    </div>
    <div>
      <NewsList items={latestNews} />
      <a href={u('/news')} class="link-arrow more">All news</a>
    </div>
  </section>

  <section class="follow container reveal">
    <hr class="rail" />
    <div class="follow-inner">
      <p>最新情報は X でお知らせしています。</p>
      <a href={site.twitterUrl} target="_blank" rel="noopener" class="link-arrow">@{site.twitter}</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    background: linear-gradient(#bdf0e6, #8fdcdc 60%, #2f4b4c);
    color: #fff;
  }
  .hero :global(.hero-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 30% 50%;
    animation: settle 6s var(--ease) both;
  }
  .hero :global(picture) { display: contents; }
  @keyframes settle { from { transform: scale(1.06); } to { transform: none; } }

  /* 透明感：全体を少し白く霞ませ、下端はページ色に溶かす */
  .hero-veil {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(60% 45% at 50% 46%, rgb(255 255 255 / 0.32), transparent 70%),
      linear-gradient(rgb(255 255 255 / 0.18), transparent 28%, transparent 68%, color-mix(in srgb, var(--paper) 70%, transparent) 92%, var(--paper));
    mix-blend-mode: normal;
  }
  /* ゆっくりと横切る光 */
  .hero-light {
    position: absolute;
    inset: -20% -40%;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.22) 46%, rgb(255 250 230 / 0.12) 52%, transparent 60%);
    animation: sheen 14s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes sheen {
    0% { transform: translateX(-40%); opacity: 0; }
    20% { opacity: 1; }
    60%, 100% { transform: translateX(40%); opacity: 0; }
  }

  /* サークル名は右下に小さく添えるだけ */
  .hero-sign {
    position: absolute;
    inset: auto 0 clamp(36px, 6vh, 64px);
    display: flex;
    justify-content: flex-end;
    animation: rise 2s var(--ease) both 0.8s;
  }
  .hero-sign :global(.hero-name) { display: block; }
  .hero-sign :global(.hero-name img) { width: clamp(150px, 15vw, 210px); height: auto; }
  @keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  .scroll {
    position: absolute;
    left: 50%;
    bottom: 28px;
    transform: translateX(-50%);
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--ink-soft);
    padding-bottom: 52px;
  }
  .scroll::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 40px;
    background: currentColor;
    animation: line 2.6s var(--ease) infinite;
  }
  @keyframes line {
    0% { transform: scaleY(0); transform-origin: top; }
    50% { transform: scaleY(1); transform-origin: top; }
    51% { transform: scaleY(1); transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }

  /* Intro：ひと目でわかる紹介 */
  .intro {
    padding-block: clamp(72px, 10vw, 120px);
    text-align: center;
  }
  .intro-text {
    font-family: var(--serif-jp);
    font-size: clamp(17px, 2vw, 22px);
    letter-spacing: 0.1em;
    line-height: 2;
  }
  .intro-meta {
    margin-top: 16px;
    font-size: 15px;
    font-style: italic;
    color: var(--mute);
    letter-spacing: 0.12em;
  }
  .intro-meta span { margin-inline: 10px; }

  /* About：詳しい紹介 */
  .about { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .about-head h2 { margin-top: 16px; font-size: 24px; letter-spacing: 0.2em; }
  .about-body .prose p + p { margin-top: 1.4em; }
  .about-body .prose { max-width: 34em; }
  .facts { margin-top: 48px; }
  .facts > div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
  }
  .facts > div:last-child { border-bottom: 1px solid var(--line); }
  .facts dt { font-size: 13px; color: var(--mute); letter-spacing: 0.14em; }
  .facts dd { margin: 0; }
  .member small { margin-left: 14px; font-size: 14px; font-style: italic; color: var(--mute); }
  .about-links { display: flex; gap: 40px; margin-top: 40px; }

  /* Featured */
  .featured-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: end;
  }
  .work-title {
    margin-top: 32px;
    font-size: clamp(88px, 14vw, 180px);
    font-weight: 400;
    letter-spacing: 0.08em;
    line-height: 1;
  }
  .work-en {
    margin-top: 24px;
    font-size: 22px;
    font-style: italic;
    font-weight: 300;
    color: var(--mute);
  }
  .status {
    display: flex;
    gap: 16px;
    align-items: center;
    font-family: var(--serif-en);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--mute);
  }
  .status span {
    font-family: var(--sans-jp);
    font-size: 12px;
    color: var(--ink);
    border: 1px solid var(--line);
    padding: 2px 12px;
    letter-spacing: 0.2em;
  }
  .catch { margin-top: 28px; font-family: var(--serif-jp); font-size: 19px; letter-spacing: 0.1em; }
  .synopsis { margin-top: 20px; margin-bottom: 48px; color: var(--ink-soft); font-size: 15px; }
  .featured-body :global(.progress) { margin-bottom: 48px; }

  /* News */
  .news { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; }
  .news-head h2 { margin-top: 16px; font-size: 24px; letter-spacing: 0.2em; }
  .news .more { margin-top: 32px; }

  /* Follow */
  .follow { padding-bottom: clamp(96px, 12vw, 160px); }
  .follow-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
    padding-top: 48px;
    color: var(--ink-soft);
  }

  @media (max-width: 640px) {
    .hero :global(.hero-image) { object-position: 22% 50%; }
  }
  @media (max-width: 820px) {
    .about, .news, .featured-inner { grid-template-columns: 1fr; gap: 32px; }
    .featured-inner { gap: 48px; }
  }
  @media (max-width: 560px) {
    .facts > div { grid-template-columns: 1fr; gap: 2px; }
    .hero-sign { justify-content: center; }
    .scroll { display: none; }
  }
</style>
