---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getDiary, formatDate, isoDate } from '../../lib/content';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const items = await getDiary();
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title}>
  <article class="container narrow article">
    <p class="label">Diary</p>
    <p class="meta en">
      <time datetime={isoDate(entry.data.date)}>{formatDate(entry.data.date)}</time>
      {entry.data.author && <span>{entry.data.author}</span>}
    </p>
    <h1>{entry.data.title}</h1>
    {entry.data.image && <Image src={entry.data.image} alt="" widths={[720, 1440]} sizes="(max-width: 800px) 100vw, 760px" class="cover" />}
    <div class="body"><Content /></div>
    <a href={u('/diary')} class="back en">← Diary</a>
  </article>
</Base>

<style>
  .article { padding-top: clamp(160px, 20vw, 220px); padding-bottom: clamp(96px, 12vw, 160px); }
  .meta { display: flex; gap: 16px; margin-top: 20px; color: var(--mute); letter-spacing: 0.1em; }
  h1 { margin-top: 8px; font-size: clamp(24px, 3.2vw, 32px); letter-spacing: 0.08em; font-weight: 500; }
  .cover { display: block; width: 100%; height: auto; margin-top: 40px; }
  .body { margin-top: 40px; line-height: 2.05; }
  .body :global(p) { margin-bottom: 1.4em; }
  .body :global(h2) { font-size: 19px; margin: 2.2em 0 0.8em; }
  .body :global(img) { margin-block: 2em; }
  .body :global(a) { border-bottom: 1px solid currentColor; }
  .back { display: inline-block; margin-top: 48px; color: var(--ink-soft); }
</style>
