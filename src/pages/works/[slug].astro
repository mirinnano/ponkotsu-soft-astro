---
import WorkLogo from '../../components/WorkLogo.astro';
import { u } from '../../lib/url';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import AjaxForm from '../../components/AjaxForm.astro';
import { formsEnabled } from '../../lib/env';
import { Image } from 'astro:assets';
import { works, type Work } from '../../data/works';

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const share = [
  { label: 'X でシェア', href: `https://twitter.com/intent/tweet?text=${enc(work.title)}&url=${enc(pageUrl)}&hashtags=${enc('ぽんこつソフト,ノベルゲーム')}` },
  { label: 'LINE で送る', href: `https://social-plugins.line.me/lineit/share?url=${enc(pageUrl)}` },
];

// The game sets each manuscript line as a paragraph: narration opens with a
// one-character indent, speech and quotations (opening with a bracket) and a
// bare silence do not. A blank manuscript line only separates paragraph
// groups; on the page it is not a gap. The same rules run in the browser
// below, so the sample can be rewritten.
const opensQuote = (line: string) => /^[「『（(〝【〈《＜<]/.test(line);
const isSilence = (line: string) => /^(……+|\.{3,})$/.test(line.trim());
const setLines = (source: string) =>
  source
    .split('\n')
    .map((line) => line.trim())
    .filter((line) => line.length > 0)
    .map((line) => ({ text: line, indent: !opensQuote(line) && !isSilence(line) }));
const sampleLines = work.manuscriptSample ? setLines(work.manuscriptSample) : [];

// The fifteen chapters of the record (the prologue and DAY 1–14). The demo opens the first five.
const dayCount = 15;
const openDays = work.days?.length ?? 0;
---
<Base
  overHero="dark"
  title={work.title}
  description={`${work.catchcopy}　${work.synopsis.slice(0, 2).join('')}`}
  image={`/images/works/${work.slug}-ogp.jpg`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: work.title,
    alternateName: work.reading,
    genre: work.genre,
    description: work.catchcopy,
    inLanguage: 'ja',
    url: pageUrl,
    image: new URL(u(`/images/works/${work.slug}-ogp.jpg`), Astro.site).href,
    author: { '@type': 'Organization', name: site.name },
  }}
>
  <div class="work">
    <!-- The split stage: the reading column scrolls; the picture beside it stays. -->
    <div class="split" data-stage-root>
      <div class="stage" aria-hidden="true">
        {work.clip && (
          <video class="stage-media is-active" data-stage="clip" autoplay muted loop playsinline preload="metadata" poster={u(work.clip.poster)}>
            <source src={u(work.clip.webm)} type="video/webm" />
            <source src={u(work.clip.mp4)} type="video/mp4" />
          </video>
        )}
      </div>

      <div class="read">
        <section class="card" aria-labelledby="work-title">
          <p class="days-band" role="img" aria-label={`全${dayCount}章のうち、体験版で読めるのは最初の${openDays}章`}>
            {Array.from({ length: dayCount }, (_, index) => <span class:list={['day-bar', { 'is-open': index < openDays }]} />)}
          </p>
          <h1 id="work-title" class="title">
            <span class="title-logo"><WorkLogo slug={work.slug} title={work.title} tone="white" loading="eager" /></span>
            <span class="headline">{work.catchcopy}</span>
          </h1>
          {work.summary && <p class="lead">{work.summary}</p>}
          <p class="meta"><span>{work.status}</span><span>{work.genre}</span><span>{work.reading}</span></p>
          <div class="actions">
            {work.demoOpen && <a class="button" href="#get">体験版を読む</a>}
            <ul class="jump">
              <li><a href="#story">あらすじ</a></li>
              {work.days?.length && <li><a href="#days">旅程</a></li>}
              <li><a href="#about">作品情報</a></li>
            </ul>
          </div>
          {work.clip && <p class="visually-hidden">{work.clip.alt}</p>}
        </section>

        <section id="story" class="story" data-stage-key="clip" aria-labelledby="story-title">
          <h2 id="story-title" class="reveal">あらすじ</h2>
          <div class="story-body reveal" style="transition-delay: 80ms">
            {work.synopsis.map((p) => <p>{p}</p>)}
          </div>
          {work.screenshots?.[0] && (
            <figure class="still reveal" style="transition-delay: 160ms">
              <Image src={work.screenshots[0].src} alt={work.screenshots[0].alt} widths={[640, 960, 1400]} sizes="(min-width: 960px) 44vw, 100vw" loading="lazy" />
              <figcaption>{work.screenshots[0].caption} の最初の頁</figcaption>
            </figure>
          )}
        </section>
      </div>
    </div>

    {sampleLines.length > 0 && work.manuscriptPhoto && (
      <section class="showcase" aria-labelledby="showcase-title">
        <div class="field field-in">
          <label class="sample-label" for="manuscript">原稿</label>
          <textarea id="manuscript" class="manuscript" spellcheck="false" rows="7" data-manuscript>{work.manuscriptSample}</textarea>
          <p class="field-note">書き換えると、ゲームの頁も組み直されます。地の文の行は一字下げ、「」で始まる行は下げません。</p>
          <h2 id="showcase-title" class="split-heading split-heading-in">原稿<span class="visually-hidden">と、ゲームの頁</span></h2>
        </div>
        <div class="field field-out">
          <div class="game-frame" data-ui aria-label="ゲームの頁">
            <Image class="game-photo" src={work.manuscriptPhoto} alt="" widths={[960, 1600]} sizes="(min-width: 960px) 46vw, 92vw" loading="lazy" />
            <div class="game-shade" aria-hidden="true"></div>
            <div class="game-page" data-page aria-live="polite">
              {sampleLines.map((line, index) => (
                <p class:list={['game-line', { 'is-indented': line.indent }]}>
                  {line.text}{index === sampleLines.length - 1 && <span class="game-mark" aria-hidden="true" />}
                </p>
              ))}
            </div>
          </div>
          <p class="split-heading split-heading-out" aria-hidden="true">ゲームの頁</p>
        </div>
      </section>
    )}

    <div class="split split-second">
      <div class="stage stage-second" aria-hidden="true">
        {work.days?.map((day, index) => (
          <Image class:list={['stage-media', { 'is-active': index === 0 }]} data-stage={`day-${index}`} src={day.image} alt="" widths={[720, 1200, 1600]} sizes="(min-width: 960px) 50vw, 100vw" loading="lazy" />
        ))}
      </div>
      <div class="read">
        {work.days?.length && (
          <section id="days" class="days" aria-labelledby="days-title">
            <h2 id="days-title" class="giant reveal">旅程</h2>
            <div class="bars">
              {work.days.map((day, index) => (
                <details class="bar reveal" data-stage-key={`day-${index}`} open={index === 0} style={`transition-delay: ${60 + index * 60}ms`}>
                  <summary>
                    <span class="bar-label">{day.label}</span>
                    <span class="bar-title">{day.title}</span>
                    <span class="bar-date">{day.date}</span>
                  </summary>
                  <div class="bar-panel">
                    <p class="bar-synopsis">{day.synopsis}</p>
                    <Image class="bar-photo" src={day.image} alt={day.imageAlt} widths={[480, 900]} sizes="(min-width: 960px) 40vw, 92vw" loading="lazy" />
                  </div>
                </details>
              ))}
              {work.daysRest && <p class="bar bar-rest reveal">{work.daysRest}</p>}
            </div>
          </section>
        )}

        <section id="about" class="about" aria-labelledby="about-title" data-stage-key={`day-${Math.max(0, (work.days?.length ?? 1) - 1)}`}>
          <h2 id="about-title" class="reveal">作品情報</h2>
          <div class="about-row">
            <dl class="facts reveal" style="transition-delay: 80ms">
              {work.specs.map((sp) => (
                <div>
                  <dt>{sp.term}</dt>
                  <dd>{sp.desc}</dd>
                </div>
              ))}
              {work.release && (
                <div>
                  <dt>発売予定</dt>
                  <dd>{work.release}</dd>
                </div>
              )}
              <div>
                <dt>進捗</dt>
                <dd>{work.progress.map((p) => `${p.label} ${p.value}%`).join('、')}</dd>
              </div>
            </dl>
            <div class="people reveal" style="transition-delay: 160ms">
              <h3 class="people-title">登場人物</h3>
              {work.characters.map((c) => (
                <div class="person">
                  <p class="person-name">{c.name}</p>
                  <p class="person-desc">{c.description}</p>
                  {c.line && <p class="person-line">「{c.line}」</p>}
                </div>
              ))}
            </div>
          </div>
        </section>
      </div>
    </div>

    {(work.demoOpen || work.betaOpen) && (
      <section id="get" class="get" aria-labelledby="get-title">
        <div class="get-words">
          <h2 id="get-title" class="closing reveal">{work.demoOpen ? '体験版を読む' : 'クローズドベータテスト'}</h2>
          <p class="closing-note reveal" style="transition-delay: 80ms">
            {work.demoOpen
              ? '体験版では、PROLOGUE から DAY 4 まで（九月二十一日の朝六時に横浜駅を出てから、松江で波の音を録るまで）を無料で読めます。セーブデータは製品版とは別に保存されます。'
              : '現在クローズドベータテスト中です。テスターの方は、アクセスコードを入力してください。'}
          </p>
        </div>
        <div class="menu reveal" data-ui style="transition-delay: 160ms">
          <p class="menu-title"><WorkLogo slug={work.slug} title={work.title} tone="white" /></p>
          {work.demoOpen && work.betaOpen && (
            <div class="segmented" role="radiogroup" aria-label="入手のしかた">
              <label><input type="radio" name="get-mode" value="demo" checked data-mode /><span>体験版</span></label>
              <label><input type="radio" name="get-mode" value="beta" data-mode /><span>テスターの方</span></label>
            </div>
          )}
          {!formsEnabled ? (
            <p class="menu-note">ダウンロードの受付は準備中です。テスターの方には X の DM でご案内しています。</p>
          ) : (
            <>
              {work.demoOpen && (
                <form action={u('/api/demo')} method="post" class="menu-form" data-ajax-form data-panel="demo">
                  <p class="menu-note">Windows・macOS・Linux 版のダウンロードリンクを表示します。</p>
                  <button type="submit" class="button button-dark">ダウンロードリンクを表示する</button>
                  <p class="status-msg" data-status aria-live="polite" />
                </form>
              )}
              {work.betaOpen && (
                <form action={u('/api/beta')} method="post" class="menu-form" data-ajax-form data-panel="beta" hidden={work.demoOpen}>
                  <label class="menu-note" for="token">アクセスコード</label>
                  <input id="token" name="token" type="text" autocomplete="off" required />
                  <button type="submit" class="button button-dark">認証する</button>
                  <p class="status-msg" data-status aria-live="polite" />
                </form>
              )}
            </>
          )}
        </div>
      </section>
    )}

    <nav class="close-line" aria-label="共有と移動">
      <p>{work.title}　{work.genre}</p>
      <ul>
        {share.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
      </ul>
      <a href={u('/works')}>作品一覧へ</a>
    </nav>
  </div>
  <AjaxForm />
</Base>

<script>
  // The picture beside the column follows what is being read: the clip of the
  // game while the story is read, then each day's photograph as its row comes.
  for (const root of document.querySelectorAll<HTMLElement>('.split')) {
    const stage = root.querySelector<HTMLElement>('.stage');
    if (!stage) continue;
    const show = (key: string) => {
      for (const media of stage.querySelectorAll<HTMLElement>('[data-stage]')) {
        const active = media.dataset.stage === key;
        media.classList.toggle('is-active', active);
        if (media instanceof HTMLVideoElement) {
          if (active) void media.play().catch(() => {});
          else media.pause();
        }
      }
    };
    const watch = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const key = (entry.target as HTMLElement).dataset.stageKey;
          if (entry.isIntersecting && key && stage.querySelector(`[data-stage="${key}"]`)) show(key);
        }
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    root.querySelectorAll<HTMLElement>('[data-stage-key]').forEach((el) => watch.observe(el));
    root.querySelectorAll<HTMLDetailsElement>('details[data-stage-key]').forEach((el) => {
      el.addEventListener('toggle', () => { if (el.open && el.dataset.stageKey) show(el.dataset.stageKey); });
    });
  }

  // The sample page is set again as the manuscript is rewritten, with the
  // game's rules (see the frontmatter).
  const manuscript = document.querySelector<HTMLTextAreaElement>('[data-manuscript]');
  const pageOut = document.querySelector<HTMLElement>('[data-page]');
  if (manuscript && pageOut) {
    const opens = /^[「『（(〝【〈《＜<]/;
    const silence = /^(……+|\.{3,})$/;
    const render = () => {
      const lines = manuscript.value.split('\n').map((line) => line.trim()).filter(Boolean).slice(0, 7);
      pageOut.replaceChildren(
        ...lines.map((line, index) => {
          const p = document.createElement('p');
          p.className = 'game-line';
          if (!opens.test(line) && !silence.test(line)) p.classList.add('is-indented');
          p.textContent = line;
          if (index === lines.length - 1) {
            const mark = document.createElement('span');
            mark.className = 'game-mark';
            mark.setAttribute('aria-hidden', 'true');
            p.append(mark);
          }
          return p;
        }),
      );
    };
    manuscript.addEventListener('input', render);
  }

  // One way to read at a time: the demo, or the testers' access code.
  const modes = document.querySelectorAll<HTMLInputElement>('[data-mode]');
  modes.forEach((mode) =>
    mode.addEventListener('change', () => {
      document.querySelectorAll<HTMLElement>('[data-panel]').forEach((panel) => {
        panel.hidden = panel.dataset.panel !== mode.value;
      });
    }),
  );
</script>

<style>
  .work {
    --w-ground: var(--night);
    --w-deep: #0b1718;
    --w-step: #22403e;
    --w-ink: var(--night-ink);
    --w-soft: var(--night-mute);
    --w-accent: var(--sea);
    --w-light: #e8f2ee;
    --w-light-ink: #10292a;
    /* Five sizes: display, heading, lead, body, small. */
    --s-display: clamp(34px, 4.2vw, 64px);
    --s-heading: clamp(26px, 2.4vw, 36px);
    --s-lead: clamp(18px, 1.35vw, 21px);
    --s-body: 17px;
    --s-small: 14px;
    background: var(--w-ground);
    color: var(--w-ink);
    font-size: var(--s-body);
  }

  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* ---- The split stage ------------------------------------------------- */
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
  .stage {
    position: sticky;
    top: 0;
    order: 2;
    height: 100svh;
    overflow: hidden;
    background: var(--w-deep);
  }
  .stage :global(.stage-media) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 1.6s var(--ease);
  }
  .stage :global(.stage-media.is-active) { opacity: 1; }
  /* The game clip is an upright phone screen. It fills the field and keeps
     its top, where the page is set; the empty foot of the screen is cut. */
  .stage video.stage-media { object-position: 50% 0; }
  .read { order: 1; padding: 0 clamp(24px, 4.4vw, 72px); }

  /* ---- First screen ---------------------------------------------------- */
  .card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100svh;
    padding-block: 112px 64px;
  }
  .days-band { display: flex; gap: 6px; height: 56px; margin: 0 0 48px; }
  .day-bar { flex: 1; background: var(--w-step); }
  .day-bar.is-open { background: var(--w-accent); }
  .title { margin: 0; font-weight: 400; }
  .title-logo { display: block; width: min(300px, 70%); margin-bottom: 28px; }
  .title-logo :global(img) { width: 100%; height: auto; }
  .headline {
    display: block;
    font-family: var(--font-mincho);
    font-size: var(--s-display);
    line-height: 1.25;
    letter-spacing: 0.02em;
    max-width: 11em;
  }
  .lead { margin: 36px 0 0; max-width: 34em; font-size: var(--s-lead); line-height: 1.7; }
  .meta { display: flex; flex-wrap: wrap; gap: 20px; margin: 20px 0 0; color: var(--w-soft); font-size: var(--s-small); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 28px 36px; margin-top: 40px; }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 28px;
    border: 0;
    background: var(--w-accent);
    color: var(--w-light-ink);
    font: 500 var(--s-body) var(--font-ui);
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: transform 0.25s var(--ease), background-color 0.25s var(--ease);
  }
  .button:hover { background: #7fd9d7; }
  .button:active { transform: translateY(1px) scale(0.99); }
  .button-dark { background: var(--w-light-ink); color: var(--w-light); }
  .button-dark:hover { background: #1d3d3e; }
  .jump { display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; font-size: var(--s-small); }
  .jump a { color: var(--w-ink); text-underline-offset: 6px; transition: color 0.25s var(--ease); }
  .jump a:hover { color: var(--w-accent); }

  /* ---- Story ----------------------------------------------------------- */
  .story { padding-block: clamp(96px, 12vw, 200px); }
  h2 { margin: 0 0 40px; font-size: var(--s-heading); font-weight: 400; letter-spacing: 0.12em; }
  .story-body { font-family: var(--font-mincho); font-size: var(--s-lead); line-height: 2.05; letter-spacing: 0.04em; }
  .story-body p { margin: 0; max-width: 30em; text-indent: 1em; }
  .story-body p + p { margin-top: 1em; }
  .still { margin: 72px 0 0; }
  .still :global(img) { display: block; width: 100%; height: auto; }
  .still figcaption { margin-top: 14px; color: var(--w-soft); font-size: var(--s-small); }

  /* ---- Showcase: manuscript in, page out -------------------------------- */
  .showcase { display: grid; grid-template-columns: 1fr 1fr; min-height: 90svh; }
  .field { position: relative; display: flex; flex-direction: column; padding: clamp(48px, 7vw, 112px) clamp(24px, 4.4vw, 72px) 96px; }
  .field-in { background: var(--w-deep); }
  .field-out { background: var(--w-light); color: var(--w-light-ink); justify-content: center; }
  .sample-label { color: var(--w-soft); font-size: var(--s-small); margin-bottom: 14px; }
  .manuscript {
    width: 100%;
    max-width: 34ch;
    min-height: 15em;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--w-ink);
    font: 400 var(--s-lead)/1.9 var(--font-mincho);
    resize: vertical;
  }
  .manuscript:focus-visible { outline: 1px solid var(--w-accent); outline-offset: 8px; }
  .field-note { margin: 24px 0 0; max-width: 30em; color: var(--w-soft); font-size: var(--s-small); line-height: 1.7; }
  .split-heading {
    position: absolute;
    bottom: 32px;
    margin: 0;
    font-family: var(--font-mincho);
    font-size: var(--s-display);
    font-weight: 400;
    line-height: 1;
    letter-spacing: 0.02em;
  }
  .split-heading-in { right: clamp(24px, 2.4vw, 40px); color: var(--w-ink); }
  .split-heading-out { left: clamp(24px, 2.4vw, 40px); color: var(--w-light-ink); }
  .game-frame {
    position: relative;
    width: 100%;
    max-width: 760px;
    aspect-ratio: 16 / 9;
    align-self: center;
    overflow: hidden;
    container-type: inline-size;
    background: #000;
    color: #eaeff2;
  }
  .game-frame :global(.game-photo) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .game-shade {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 62% at 50% 34%, rgb(4 6 8 / 56%), rgb(4 6 8 / 14%) 78%, transparent); /* taste-skill-ignore: the game's own neutral scrim under its page, over the photograph */
  }
  /* The game's page, scaled from its 1280-wide stage: 31px type, set from 100px down. */
  .game-page {
    position: absolute;
    top: 13.9cqw;
    left: 50%;
    width: 82cqw;
    translate: -50% 0;
    font-family: var(--font-mincho);
    font-size: 2.42cqw;
    line-height: 1.9;
    letter-spacing: 0.025em;
  }
  .game-line { margin: 0; }
  .game-line.is-indented { text-indent: 1em; }
  .game-mark { display: inline-block; width: 0.3em; height: 0.3em; margin-left: 0.42em; background: currentColor; rotate: 45deg; vertical-align: 0.12em; animation: mark 1.8s ease-in-out infinite; }
  @keyframes mark { 0%, 100% { opacity: 0.22; } 50% { opacity: 0.85; } }

  /* ---- Days ----------------------------------------------------------- */
  .days { padding-block: clamp(96px, 12vw, 200px) 64px; container-type: inline-size; }
  .giant { margin: 0 0 24px; font-family: var(--font-mincho); font-size: 44cqw; line-height: 0.9; letter-spacing: -0.02em; }
  .bars { display: grid; gap: 6px; }
  .bar { background: var(--w-step); }
  .bar summary {
    display: grid;
    grid-template-columns: 6.5em minmax(0, 1fr) auto;
    gap: 16px;
    align-items: center;
    min-height: 56px;
    padding: 0 18px;
    cursor: pointer;
    list-style: none;
    transition: background-color 0.25s var(--ease);
  }
  .bar summary::-webkit-details-marker { display: none; }
  .bar summary:hover { background: #2a4c4a; }
  .bar[open] summary { background: var(--w-accent); color: var(--w-light-ink); }
  .bar-label { font-size: var(--s-body); }
  .bar-title { font-family: var(--font-mincho); font-size: var(--s-lead); }
  .bar-date { font-size: var(--s-small); font-variant-numeric: tabular-nums; }
