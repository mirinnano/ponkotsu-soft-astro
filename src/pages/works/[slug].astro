---
import WorkLogo from '../../components/WorkLogo.astro';
import { u } from '../../lib/url';
import { site } from '../../data/site';
import Base from '../../layouts/Base.astro';
import AjaxForm from '../../components/AjaxForm.astro';
import { formsEnabled } from '../../lib/env';
import { Image } from 'astro:assets';
import { works, type Work } from '../../data/works';

export function getStaticPaths() {
  return works.map((work) => ({ params: { slug: work.slug }, props: { work } }));
}

const { work } = Astro.props as { work: Work };
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
const share = [
  { label: 'X でシェア', href: `https://twitter.com/intent/tweet?text=${enc(work.title)}&url=${enc(pageUrl)}&hashtags=${enc('ぽんこつソフト,ノベルゲーム')}` },
  { label: 'LINE で送る', href: `https://social-plugins.line.me/lineit/share?url=${enc(pageUrl)}` },
];
---

<Base
  overHero="dark"
  title={work.title}
  description={`${work.catchcopy}　${work.synopsis.slice(0, 2).join('')}`}
  image={`/images/works/${work.slug}-ogp.jpg`}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'VideoGame',
    name: work.title,
    alternateName: work.reading,
    genre: work.genre,
    description: work.catchcopy,
    inLanguage: 'ja',
    url: pageUrl,
    image: new URL(u(`/images/works/${work.slug}-ogp.jpg`), Astro.site).href,
    author: { '@type': 'Organization', name: site.name },
  }}
>
  <section class="night hero">
    <div class="container narrow hero-inner">
      <h1 class="title"><WorkLogo slug={work.slug} title={work.title} tone="white" loading="eager" /></h1>
      <p class="meta"><span class="status">{work.status}</span><span class="en">{work.genre}</span><span>{work.reading}</span></p>
      <p class="catch">{work.catchcopy}</p>
    </div>
  </section>

  {work.keyVisual && (
    <figure class="key-visual">
      <Image src={work.keyVisual} alt={work.keyVisualAlt ?? `${work.title} キービジュアル`} widths={[960, 1600, 2400]} sizes="100vw" loading="eager" />
    </figure>
  )}

  <section class="section container narrow story reveal">
    <h2>あらすじ</h2>
    <div class="story-body">
      {work.synopsis.map((p) => <p>{p}</p>)}
      <span class="wait" aria-hidden="true">▼</span>
    </div>
  </section>

  {work.trailer && (
    <section class="container narrow block trailer reveal">
      <h2>PV</h2>
      <div class="video">
        <iframe src={`https://www.youtube-nocookie.com/embed/${work.trailer}`} title={`${work.title} PV`} loading="lazy" allow="encrypted-media; picture-in-picture" allowfullscreen></iframe>
      </div>
    </section>
  )}

  <section class="container narrow block characters-section reveal">
    <h2>登場人物</h2>
    <ul class="characters">
      {
        work.characters.map((c) => (
          <li>
            <p class="role en">{c.role}</p>
            <h3>{c.name}</h3>
            {c.line && <p class="line">「{c.line}」</p>}
            <p class="desc">{c.description}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section container narrow block reveal">
    <h2>作品情報</h2>
    <dl class="specs">
      {
        work.specs.map((sp) => (
          <div>
            <dt>{sp.term}</dt>
            <dd>{sp.desc}</dd>
          </div>
        ))
      }
      {work.release && (
        <div>
          <dt>発売予定</dt>
          <dd>{work.release}</dd>
        </div>
      )}
      <div>
        <dt>進捗</dt>
        <dd>{work.progress.map((p) => `${p.label} ${p.value}%`).join('、')}</dd>
      </div>
    </dl>
  </section>

  {work.stores?.length && (
    <section class="container narrow block stores reveal">
      <h2>入手方法</h2>
      <ul>
        {work.stores.map((st) => <li><a href={st.href} target="_blank" rel="noopener" class="link-arrow">{st.label}</a></li>)}
      </ul>
    </section>
  )}

  {
    work.betaOpen && (
      <section id="download" class="download">
        <div class="container narrow section reveal">
          <h2>クローズドベータテスト</h2>
          <p class="note">現在クローズドベータテスト中です。テスターの方は、以下にアクセスコードを入力してください。</p>
          {!formsEnabled ? (
            <p class="notice">ダウンロードの受付は準備中です。テスターの方には X の DM でご案内しています。</p>
          ) : (
          <form action={u('/api/beta')} method="post" class="beta-form" data-ajax-form>
            <label class="visually-hidden" for="token">アクセスコード</label>
            <div class="field">
              <input id="token" name="token" type="text" placeholder="アクセスコード" autocomplete="off" required />
              <button type="submit">認証する</button>
            </div>
            <p class="status-msg" data-status aria-live="polite" />
          </form>
          )}
        </div>
      </section>
    )
  }

  <section class="container narrow share">
    <ul>
      {share.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label}</a></li>)}
    </ul>
    <a href={u('/works')} class="back en">← All works</a>
  </section>

  <AjaxForm />
</Base>

<style>
  .hero { display: flex; }
  .hero-inner {
    display: flex;
    flex-direction: column;
    padding-top: clamp(150px, 18vw, 220px);
    padding-bottom: clamp(64px, 8vw, 96px);
  }
  .title { animation: fade 2.4s var(--ease) both 0.2s; margin-bottom: 36px; }
  .title :global(img) { width: clamp(240px, 46vw, 520px); height: auto; }
  .hero-text { animation: fade 2s var(--ease) both 0.9s; }
  .meta { display: flex; gap: 16px; align-items: center; font-size: 13px; color: var(--mute); }
  .status { border: 1px solid var(--line); padding: 1px 12px; color: var(--ink); font-size: 12px; letter-spacing: 0.2em; }
  .catch { margin-top: 20px; font-family: var(--font-ui); font-size: clamp(16px, 1.8vw, 20px); letter-spacing: 0.14em; }
  @keyframes fade { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }

  h2 { font-size: 22px; letter-spacing: 0.16em; margin-bottom: 32px; }
  /* あらすじは小説の頁のように明朝で。広い画面では縦書き。最後に、ノベルゲームの頁送りの ▼ だけを置く */
  .story-body {
    font-family: var(--font-mincho);
    font-size: 16px;
    line-height: 2.1;
    letter-spacing: 0.08em;
  }
  .story-body p { max-width: 34em; }
  .story-body p + p { margin-top: 1.2em; }
  .wait {
    display: inline-block;
    margin-top: 0.6em;
    font-size: 11px;
    color: var(--mute);
    animation: wait 1.4s steps(2, jump-none) infinite;
  }
  @keyframes wait { 50% { opacity: 0; } }
  @media (min-width: 900px) {
    .story-body {
      writing-mode: vertical-rl;
      height: 26em;
      max-width: 100%;
      overflow-x: auto;
      margin-left: auto;
      font-size: 17px;
      line-height: 2.2;
    }
    .story-body p { max-width: none; }
    .story-body p + p { margin-top: 0; margin-right: 1.6em; }
    .wait { margin-top: 0; margin-right: 1em; align-self: flex-end; }
  }

  .setting { margin-top: 10px; font-size: 13px; color: var(--mute); letter-spacing: 0.12em; }
  .specs > div { display: grid; grid-template-columns: 96px 1fr; gap: 20px; padding-block: 16px; border-top: 1px solid var(--line); }
  .specs > div:last-child { border-bottom: 1px solid var(--line); }
  .specs dt { font-size: 13px; color: var(--mute); letter-spacing: 0.14em; }
  .specs dd { margin: 0; }
  .characters-section { padding-bottom: 0; }
  .key-visual { margin: 0; }
  .key-visual :global(img) { display: block; width: 100%; height: auto; max-height: 80svh; object-fit: cover; }
  .trailer { padding-bottom: clamp(80px, 10vw, 140px); }
  .video { position: relative; aspect-ratio: 16 / 9; background: var(--paper-2); }
  .video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .stores { padding-bottom: clamp(80px, 10vw, 140px); }
  .stores ul { display: flex; flex-wrap: wrap; gap: 20px 40px; }
  .characters { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .characters li { background: var(--paper); padding: 40px 32px; }
  .role { font-size: 13px; color: var(--mute); }
  .characters h3 { font-size: 26px; letter-spacing: 0.2em; margin-block: 6px 18px; }
  .characters .line { font-family: var(--font-mincho); font-size: 16px; letter-spacing: 0.06em; margin-bottom: 14px; }
  .characters .desc { font-size: 15px; color: var(--ink-soft); }


  .download { background: var(--paper-2); }
  .note { color: var(--ink-soft); max-width: 32em; }
  .beta-form { margin-top: 36px; max-width: 520px; }
  .notice { margin-top: 32px; max-width: 520px; padding: 20px 24px; border: 1px solid var(--line); background: var(--paper); }
  .field {
    display: grid;
    grid-template-columns: 1fr auto;
    border-bottom: 1px solid var(--ink);
  }
  .beta-form input {
    font: inherit;
    font-size: 15px;
    letter-spacing: 0.12em;
    background: transparent;
    border: 0;
    color: var(--ink);
    padding: 14px 0;
    min-width: 0;
  }
  .beta-form input:focus { outline: none; }
  .beta-form button {
    font-family: var(--font-ui);
    font-size: 14px;
    letter-spacing: 0.2em;
    background: none;
    border: 0;
    color: var(--ink);
    cursor: pointer;
    padding: 14px 0 14px 24px;
  }
  .beta-form button:disabled { opacity: 0.4; }
  .status-msg { margin-top: 16px; font-size: 13px; color: var(--ink-soft); }
  .status-msg[data-state='error'] { color: #a4533f; }

  .share {
    justify-content: space-between;
    display: flex;
    align-items: center;
    gap: 32px;
    flex-wrap: wrap;
    padding-block: 64px clamp(96px, 12vw, 140px);
  }
  .share ul { display: flex; gap: 8px; }
  .share a { display: inline-block; padding: 10px 12px; font-family: var(--font-ui); letter-spacing: 0.12em; color: var(--ink-soft); transition: color 0.3s; }
  .share a:hover { color: var(--ink); }
  .share li:first-child a { padding-left: 0; }
  .back { margin-left: auto; }

  @media (max-width: 820px) {
    .characters { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .title :global(img) { width: 72%; }
  }
</style>
