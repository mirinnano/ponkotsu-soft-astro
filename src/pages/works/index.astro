---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { works, totalProgress } from '../../data/works';
---

<Base title="Works" description="ぽんこつソフトの作品一覧。">
  <PageHeader label="Works" title="作品" />

  <section class="container list">
    {
      works.map((w) => (
        <a href={u(`/works/${w.slug}`)} class="work reveal">
          <div class="body">
            <p class="meta">
              <span class="status">{w.status}</span>
              <span class="en">{w.genre}</span>
            </p>
            <h2>{w.title}</h2>
            <p class="catch">{w.catchcopy}</p>
            <p class="setting">{w.setting}</p>
            <p class="synopsis">{w.synopsis.slice(0, 2).join('')}</p>
            <p class="foot">
              <span class="en">Progress — {totalProgress(w)}%</span>
              <span class="link-arrow">Read more</span>
            </p>
          </div>
        </a>
      ))
    }
  </section>
</Base>

<style>
  .list { padding-bottom: clamp(96px, 12vw, 160px); }
  .body { max-width: 760px; }
  .work {
    display: grid;
    grid-template-columns: 1fr;
    padding-block: 56px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .meta { display: flex; gap: 16px; align-items: center; font-size: 13px; color: var(--mute); }
  .status { border: 1px solid var(--line); padding: 1px 12px; color: var(--ink); font-size: 12px; letter-spacing: 0.2em; }
  h2 { margin-top: 20px; font-family: var(--font-mincho); font-size: clamp(40px, 6vw, 64px); line-height: 1.2; letter-spacing: 0.16em; }
  .catch { margin-top: 12px; font-family: var(--font-ui); font-size: 17px; letter-spacing: 0.08em; }
  .setting { margin-top: 6px; font-size: 13px; color: var(--mute); letter-spacing: 0.12em; }
  .synopsis { margin-top: 24px; font-size: 15px; color: var(--ink-soft); }
  .foot {
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    color: var(--mute);
  }
  @media (max-width: 760px) {
    .work { grid-template-columns: 1fr; }
  </style>
