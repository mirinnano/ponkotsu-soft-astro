---
// イベント告知の詳細ページ（お品書きを載せる）
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getNews, formatDate, isoDate } from '../../lib/content';
import { u } from '../../lib/url';

export async function getStaticPaths() {
  const items = await getNews('event');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const ev = entry.data.event;
---

<Base title={entry.data.title} description={entry.data.summary}>
  <article class="container narrow article">
    <p class="label">Event</p>
    <time datetime={isoDate(entry.data.date)} class="en">{formatDate(entry.data.date)}</time>
    <h1>{entry.data.title}</h1>
    {
      ev && (
        <dl class="event">
          <div><dt>イベント</dt><dd>{ev.name}</dd></div>
          <div><dt>日程</dt><dd>{formatDate(ev.date)}{ev.day && `（${ev.day}）`}</dd></div>
          {ev.space && <div><dt>スペース</dt><dd>{ev.space}</dd></div>}
          {ev.venue && <div><dt>会場</dt><dd>{ev.venue}</dd></div>}
        </dl>
      )
    }
    {entry.data.image && <Image src={entry.data.image} alt={`${entry.data.title}のお品書き`} widths={[720, 1440]} sizes="(max-width: 800px) 100vw, 760px" class="menu" />}
    <div class="body"><Content /></div>
    <a href={u('/news')} class="back en">← All news</a>
  </article>
</Base>

<style>
  .article { padding-top: clamp(160px, 20vw, 220px); padding-bottom: clamp(96px, 12vw, 160px); }
  time { display: block; margin-top: 20px; color: var(--mute); letter-spacing: 0.1em; }
  h1 { margin-top: 8px; font-size: clamp(24px, 3.2vw, 32px); letter-spacing: 0.08em; font-weight: 500; }
  .event { margin-top: 40px; }
  .event > div { display: grid; grid-template-columns: 100px 1fr; gap: 24px; padding-block: 14px; border-top: 1px solid var(--line); }
  .event > div:last-child { border-bottom: 1px solid var(--line); }
  .event dt { font-size: 13px; color: var(--mute); letter-spacing: 0.14em; }
  .event dd { margin: 0; }
  .menu { display: block; width: 100%; height: auto; margin-top: 40px; }
  .body { margin-top: 40px; }
  .body :global(p) { margin-bottom: 1.2em; }
  .body :global(a) { border-bottom: 1px solid currentColor; }
  .back { display: inline-block; margin-top: 48px; color: var(--ink-soft); }
</style>
