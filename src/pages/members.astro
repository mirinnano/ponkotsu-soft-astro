---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { Image } from 'astro:assets';
import { members } from '../data/members';
---

<Base title="Members" description="ぽんこつソフトのメンバー紹介。">
  <PageHeader label="Members" title="メンバー" />

  <section class="container narrow list">
    {
      members.map((m) => (
        <article class="member reveal">
          {m.avatar ? (
            <Image src={m.avatar} alt="" width={171} height={171} class="mark photo" />
          ) : (
            <div class="mark" aria-hidden="true">{m.name.slice(0, 1)}</div>
          )}
          <div>
            <h2>{m.name}</h2>
            <ul class="roles">
              {m.roles.map((r) => <li class="en">{r}</li>)}
            </ul>
            <p class="bio">{m.bio}</p>
            {(m.x || m.github) && (
              <p class="links">
                {m.x && <a href={`https://x.com/${m.x}`} target="_blank" rel="noopener" class="link-arrow">X @{m.x}</a>}
                {m.github && <a href={`https://github.com/${m.github}`} target="_blank" rel="noopener" class="link-arrow">GitHub</a>}
              </p>
            )}
          </div>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .list { padding-bottom: clamp(96px, 12vw, 160px); }
  .member + .member { border-top: 0; }
  .photo { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; filter: grayscale(0.15); }
  .links { display: flex; gap: 32px; flex-wrap: wrap; }
  .member {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: clamp(32px, 6vw, 80px);
    padding-block: 56px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .mark {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: var(--paper-2);
    font-family: var(--font-ui);
    font-size: 72px;
    color: var(--mute);
  }
  h2 { font-size: 26px; letter-spacing: 0.2em; }
  .roles { display: flex; flex-wrap: wrap; gap: 6px 20px; margin-top: 10px; }
  .roles li { font-size: 14px; color: var(--mute); }
  .bio { margin-block: 24px 32px; max-width: 34em; color: var(--ink-soft); white-space: pre-line; word-break: keep-all; overflow-wrap: anywhere; }
  @media (max-width: 640px) {
    .member { grid-template-columns: 1fr; }
    .mark { width: 120px; font-size: 44px; }
  }
</style>
