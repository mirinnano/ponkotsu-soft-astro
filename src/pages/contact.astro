---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import AjaxForm from '../components/AjaxForm.astro';
import { site } from '../data/site';
import { isStaticPreview } from '../lib/env';
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
---

<Base title="Contact" description="ぽんこつソフトへのお問い合わせ。">
  <PageHeader label="Contact" title="お問い合わせ" />

  <section class="container narrow block form-section">
    <div class="reveal">
      <h2>お問い合わせフォーム</h2>
      <p class="note">
        ご感想・ご質問・取材のご相談などはこちらからお送りください。二次創作については <a href={u('/about#guideline')}>ガイドライン</a> をご覧ください。
      </p>
      {isStaticPreview ? (
        <p class="notice">このプレビュー版ではフォームを送信できません。X の DM からご連絡ください。</p>
      ) : (
      <form action={u('/api/contact')} method="post" class="form" data-ajax-form data-success="送信しました。お問い合わせありがとうございます。">
        <label>
          <span>お名前<em>必須</em></span>
          <input name="name" type="text" autocomplete="name" required maxlength="100" />
        </label>
        <label>
          <span>メールアドレス<em>必須</em></span>
          <input name="email" type="email" autocomplete="email" required maxlength="200" />
        </label>
        <label>
          <span>件名</span>
          <input name="subject" type="text" maxlength="200" />
        </label>
        <label>
          <span>メッセージ<em>必須</em></span>
          <textarea name="message" rows="6" required maxlength="4000"></textarea>
        </label>
        <label class="hp" aria-hidden="true">
          <span>Website</span>
          <input name="website" type="text" tabindex="-1" autocomplete="off" />
        </label>
        {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-language="ja" />}
        <div class="submit-row">
          <button type="submit" class="link-arrow">送信する</button>
          <p class="status-msg" data-status aria-live="polite"></p>
        </div>
      </form>
      )}
    </div>
  </section>

  <section class="container narrow block sns">
    <div class="reveal">
      <a href={site.twitterUrl} target="_blank" rel="noopener" class="link-arrow">X (Twitter) — @{site.twitter}</a>
    </div>
  </section>

  <AjaxForm />
  {PUBLIC_TURNSTILE_SITE_KEY && !isStaticPreview && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</Base>

<style>
  .block { }
  h2 { font-size: 22px; letter-spacing: 0.2em; margin-bottom: 36px; }

  .form-section { padding-bottom: clamp(56px, 7vw, 96px); }
  .note { color: var(--ink-soft); margin-bottom: 40px; }
  .note a { border-bottom: 1px solid currentColor; }
  .notice { padding: 20px 24px; border: 1px solid var(--line); background: var(--paper-2); }
  .form { display: grid; gap: 28px; max-width: 560px; }
  .form label { display: grid; gap: 4px; }
  .form label span { font-size: 13px; letter-spacing: 0.12em; color: var(--ink-soft); }
  .form label em { font-style: normal; font-size: 11px; margin-left: 10px; padding: 1px 6px; border: 1px solid var(--line); color: var(--mute); letter-spacing: 0.1em; }
  .form input, .form textarea {
    font: inherit;
    font-size: 15px;
    color: var(--ink);
    background: transparent;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    padding: 10px 0;
    transition: border-color 0.3s;
    resize: vertical;
  }
  .form input:focus, .form textarea:focus { outline: none; border-bottom-color: var(--ink); }
  .hp { position: absolute; left: -9999px; }
  .submit-row { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 12px; }
  .submit-row button {
    background: none;
    border: 0;
    border-bottom: 1px solid currentColor;
    color: var(--ink);
    cursor: pointer;
    font-family: var(--font-ui);
    font-size: 15px;
    padding: 10px 0 6px;
  }
  .submit-row button:disabled { opacity: 0.4; }
  .status-msg { font-size: 13px; color: var(--ink-soft); }
  .status-msg[data-state='error'] { color: #a4533f; }
  .sns { padding-bottom: clamp(96px, 12vw, 160px); }

  @media (max-width: 820px) {
  }
</style>
