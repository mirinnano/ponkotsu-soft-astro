---
import { u } from '../lib/url';
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import { getNews, formatDate } from '../lib/content';

const facts = [
  { term: 'サークル名', desc: site.name },
  { term: '設立', desc: `${site.founded}年` },
  { term: '活動内容', desc: 'ビジュアルノベル（キネティックノベル）の企画・制作' },
  { term: '制作中', desc: 'HesPhoros（ヘスフォロス）' },
  { term: '制作環境', desc: '自作のノベルゲームエンジン AriaEngine' },
  { term: '連絡先', desc: 'X（@ponkotusoft）、お問い合わせフォーム' },
];

// 沿革はお知らせから（古い順）
const history = (await getNews()).slice().reverse();
---

<Base title="About" description="ぽんこつソフトのサークル概要、沿革、二次創作ガイドライン。">
  <PageHeader label="About" title="ぽんこつソフトについて" />

  <section class="container narrow about">
    <div class="statement prose reveal">
      <p>
        ぽんこつソフトは、少しダークで切ないノベルゲームをつくる同人サークルです。シナリオは、2000年前後のノベルゲームに強く影響を受けています。
      </p>
      <p>
        立ち絵は大事な場面だけに使い、風景と文章で読ませる作品を目指しています。いま制作しているのは、鈍行列車で西へ向かう二人の十四日間を描くキネティックノベル『HesPhoros』です。
      </p>
    </div>

    <dl class="facts reveal">
      {
        facts.map((f) => (
          <div>
            <dt>{f.term}</dt>
            <dd>{f.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container narrow block" id="history">
    <div class="reveal">
      <h2>沿革</h2>
      <ol class="history">
        {
          history.map((h) => (
            <li>
              <time class="en" datetime={h.data.date.toISOString().slice(0, 10)}>{formatDate(h.data.date)}</time>
              <span>{h.data.title}</span>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="container narrow block" id="guideline">
    <div class="reveal guideline">
      <h2>二次創作ガイドライン</h2>
      <dl>
        <div>
          <dt>許諾範囲</dt>
          <dd>当サークルの作品に関する二次創作（イラスト、小説、動画等）は、非営利かつ個人利用の範囲で自由に作成・公開していただけます。</dd>
        </div>
        <div>
          <dt>禁止事項</dt>
          <dd>
            <ul>
              <li>商業利用</li>
              <li>著作権侵害を伴う行為</li>
              <li>公序良俗に反する内容</li>
              <li>当サークルまたは作品の名誉を傷つける内容</li>
            </ul>
          </dd>
        </div>
        <div>
          <dt>クレジット表記</dt>
          <dd>二次創作作品を公開する際は、作品タイトルと当サークル名を明記してください。</dd>
        </div>
      </dl>
      <p class="ask">ご不明な点は <a href={u('/contact')}>お問い合わせ</a> からどうぞ。</p>
    </div>
  </section>
</Base>

<style>
  .about { padding-bottom: clamp(80px, 10vw, 140px); }
  .about .facts { margin-top: 48px; }
  .statement p { font-size: clamp(16px, 1.5vw, 18px); }
  .statement p + p { margin-top: 2em; }
  .facts > div { padding-block: 22px; border-top: 1px solid var(--line); }
  .facts > div:last-child { border-bottom: 1px solid var(--line); }
  dt { font-size: 13px; letter-spacing: 0.14em; color: var(--mute); }
  dd { margin: 6px 0 0; font-size: 15px; }
  .block { padding-bottom: clamp(80px, 10vw, 140px); }
  h2 { font-size: 22px; letter-spacing: 0.2em; margin-bottom: 32px; }
  .history li { display: grid; grid-template-columns: 120px 1fr; gap: 24px; padding-block: 14px; border-top: 1px solid var(--line); }
  .history li:last-child { border-bottom: 1px solid var(--line); }
  .history time { color: var(--mute); letter-spacing: 0.08em; }
  .guideline dl > div { padding-block: 22px; border-top: 1px solid var(--line); }
  .guideline dl > div:last-child { border-bottom: 1px solid var(--line); }
  .guideline dd { max-width: 34em; }
  .guideline dd li::before { content: '—'; margin-right: 0.8em; color: var(--mute); }
  .ask { margin-top: 28px; color: var(--ink-soft); }
  .ask a { border-bottom: 1px solid currentColor; }

</style>
