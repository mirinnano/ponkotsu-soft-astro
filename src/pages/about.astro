---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { site } from '../data/site';
import Logo from '../components/Logo.astro';

const facts = [
  { term: 'サークル名', desc: site.name },
  { term: '設立', desc: `${site.founded}年` },
  { term: '活動内容', desc: 'ビジュアルノベル（キネティックノベル）の企画・制作' },
  { term: '制作中', desc: '海風（キネティックノベル）' },
];
---

<Base title="About" description="ぽんこつソフトについて。少しダークで切ない純文学風ビジュアルノベルを制作するサークルです。">
  <PageHeader label="About" title="ぽんこつソフトについて" />

  <section class="container about">
    <div class="statement prose reveal">
      <p>
        ぽんこつソフトは、息苦しい日常から逃げ出したいと願う人へ向けて、少しダークで切ない純文学風ビジュアルノベルを制作するサークルです。
      </p>
      <p>
        名作ノベルゲームの系譜を受け継ぎ、優しくて冷たい「もう一つの現実」をテキストで紡いでいます。
      </p>
    </div>

    <dl class="facts reveal">
      {
        facts.map((f) => (
          <div>
            <dt>{f.term}</dt>
            <dd>{f.desc}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container logo-block reveal">
    <hr class="rail" />
    <Logo kind="stacked" class="about-logo" />
  </section>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: clamp(48px, 8vw, 120px);
    padding-bottom: clamp(96px, 12vw, 160px);
  }
  .statement p { font-size: clamp(16px, 1.5vw, 18px); }
  .statement p + p { margin-top: 2em; }
  .facts > div { padding-block: 22px; border-top: 1px solid var(--line); }
  .facts > div:last-child { border-bottom: 1px solid var(--line); }
  dt { font-size: 12px; letter-spacing: 0.2em; color: var(--mute); }
  dd { margin: 6px 0 0; font-size: 15px; }
  .logo-block { padding-bottom: clamp(96px, 12vw, 160px); }
  .logo-block :global(.about-logo) { display: block; width: min(300px, 70%); margin: clamp(72px, 10vw, 120px) auto 0; }
  .logo-block :global(.about-logo img) { width: 100%; height: auto; }
  @media (max-width: 820px) {
    .about { grid-template-columns: 1fr; }
  }
</style>
