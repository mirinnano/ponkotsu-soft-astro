---
import { u } from '../lib/url';
import { site } from '../data/site';
import { getNav } from '../lib/content';
import Logo from './Logo.astro';
const nav = await getNav();
const year = new Date().getFullYear();
---

<footer class="site-footer night">
  <div class="container">
    <div class="top">
      <a href={u('/')} class="logo" aria-label={site.name}>
        <Logo kind="stacked" tone="light" />
      </a>
      <div class="cols">
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        </ul>
        <ul>
          <li><a href={site.twitterUrl} target="_blank" rel="noopener">X (Twitter) ↗</a></li>
        </ul>
      </div>
    </div>
    <p class="tagline">{site.tagline}</p>
    <hr class="rail" />
    <p class="copy en">&copy; {year} {site.nameEn}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: 96px 40px; }
  .top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
    flex-wrap: wrap;
  }
  .logo { display: block; width: min(220px, 60vw); opacity: 0.92; transition: opacity 0.3s; }
  .logo:hover { opacity: 1; }
  .cols { display: flex; gap: 72px; }
  .cols a {
    font-family: var(--serif-en);
    font-size: 15px;
    letter-spacing: 0.14em;
    color: var(--mute);
    line-height: 2.3;
    transition: color 0.3s;
  }
  .cols a:hover { color: var(--ink); }
  .tagline {
    margin-top: 72px;
    margin-bottom: 28px;
    font-size: 13px;
    letter-spacing: 0.3em;
    color: var(--mute);
  }
  .copy { margin-top: 24px; font-size: 12px; color: var(--mute); }
  @media (max-width: 560px) {
    .cols { gap: 40px; }
  }
</style>
