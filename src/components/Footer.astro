---
import { u } from '../lib/url';
import { site } from '../data/site';
import { getNav } from '../lib/content';
import Logo from './Logo.astro';
const nav = await getNav();
const year = new Date().getFullYear();
---

<footer class="site-footer night">
  <div class="container inner">
    <a href={u('/')} class="logo" aria-label={site.name}>
      <Logo kind="compact" tone="white" />
    </a>
    <ul class="links">
      {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      <li><a href={u('/presskit')}>Press kit</a></li>
      <li><a href={site.twitterUrl} target="_blank" rel="noopener">X ↗</a></li>
    </ul>
    <p class="copy en">&copy; {year} {site.nameEn}</p>
  </div>
</footer>

<style>
  .site-footer { padding-block: 56px; }
  .inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 24px 48px;
  }
  .logo { display: block; }
  .logo :global(img) { height: 16px; width: auto; }
  .links { display: flex; flex-wrap: wrap; gap: 4px 28px; }
  .links a {
    display: inline-block;
    padding-block: 6px;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--mute);
    transition: color 0.3s;
  }
  .links a:hover { color: var(--ink); }
  .copy { font-size: 12px; color: var(--mute); }
  @media (max-width: 820px) {
    .inner { grid-template-columns: 1fr; }
  }
</style>
