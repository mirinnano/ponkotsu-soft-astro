---
// data-ajax-form を持つ form を fetch で送信し、結果を [data-status] に表示する共通スクリプト
---

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-ajax-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true;
      status.textContent = '送信中…';
      status.dataset.state = '';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const body = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(body.error ?? '送信に失敗しました。');
        if (Array.isArray(body.files)) {
          // OS ごとのダウンロード。リンクは 10 分で切れる
          status.innerHTML = '';
          const list = document.createElement('ul');
          list.className = 'download-list';
          for (const file of body.files) {
            const item = document.createElement('li');
            const a = Object.assign(document.createElement('a'), {
              href: file.url,
              textContent: `${file.label} 版をダウンロード →`,
              className: 'link-arrow',
            });
            const size = document.createElement('span');
            size.className = 'download-size';
            size.textContent = `${(file.size / 1024 / 1024).toFixed(0)} MB`;
            item.append(a, size);
            list.append(item);
          }
          status.append(`認証しました（${body.version}）。リンクは 10 分間有効です。`, list);
        } else if (body.url) {
          status.innerHTML = '';
          const a = Object.assign(document.createElement('a'), {
            href: body.url,
            textContent: 'ダウンロードを開始 →',
            className: 'link-arrow',
          });
          status.append('認証しました。', document.createElement('br'), a);
        } else {
          status.textContent = form.dataset.success ?? '送信しました。';
          form.reset();
        }
        status.dataset.state = 'ok';
      } catch (err) {
        status.textContent = (err as Error).message;
        status.dataset.state = 'error';
      } finally {
        button.disabled = false;
      }
    });
  });
</script>

<style is:global>
  .download-list { list-style: none; padding: 0; margin-top: 12px; display: grid; gap: 10px; }
  .download-list li { display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }
  .download-size { font-size: 12px; color: var(--mute); letter-spacing: 0.08em; }
</style>
