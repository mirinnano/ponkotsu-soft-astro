---
// 作品ロゴ（public/images/works/<slug>-logo-<black|white>.svg）。auto は OS のダークモードで黒/白を切り替える
import { u } from '../lib/url';

interface Props {
  slug: string;
  title: string;
  tone?: 'auto' | 'black' | 'white';
  class?: string;
  loading?: 'eager' | 'lazy';
}
const { slug, title, tone = 'auto', class: className, loading = 'lazy' } = Astro.props;
const size = [1912, 309];
const src = (t: 'black' | 'white') => u(`/images/works/${slug}-logo-${t}.svg`);
---

{
  tone === 'auto' ? (
    <picture class={className}>
      <source srcset={src('white')} media="(prefers-color-scheme: dark)" />
      <img src={src('black')} alt={title} width={size[0]} height={size[1]} loading={loading} decoding="async" />
    </picture>
  ) : (
    <img class={className} src={src(tone)} alt={title} width={size[0]} height={size[1]} loading={loading} decoding="async" />
  )
}
